# ==== Database ====
# PostgreSQL 18 from docker-compose.yml / podman compose (user/pass/db: postgres/postgres/marketing_copilot)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketing_copilot

# ==== LLM (OpenAI-compatible endpoint, e.g. 9Router, via ADK LiteLlm) ====
OPENAI_API_KEY=sk-put-your-api-key-here
# Replace with your 9Router endpoint URL (OpenAI-compatible, ending in /v1)
OPENAI_BASE_URL=https://<YOUR-9ROUTER-BASE>/v1
LLM_MODEL=my-free-deepseek-v4-flash
LLM_MAX_TOKENS=4096

# ==== Telegram ====
# Leave empty if unavailable / dry-run only
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Telegram message parse_mode: empty = plain text (safest with emoji) | "HTML" | "MarkdownV2"
TELEGRAM_PARSE_MODE=

# ==== Prime-time slots (used in the message title & outputs/ filenames) ====
PRIME_TIME_MORNING=MORNING
PRIME_TIME_EVENING=EVENING
PRIME_TIME_NIGHT=NIGHT