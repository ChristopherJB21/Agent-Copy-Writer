# ==== Database ====
# PostgreSQL 18 dari docker-compose.yml / podman compose (user/pass/db: postgres/postgres/marketing_copilot)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketing_copilot

# ==== LLM (OpenAI-compatible endpoint, mis. 9Router, via ADK LiteLlm) ====
OPENAI_API_KEY=sk-isi-api-key-kamu
# Ganti dengan base URL endpoint 9Router kamu (format OpenAI-compatible, diakhiri /v1)
OPENAI_BASE_URL=https://<YOUR-9ROUTER-BASE>/v1
LLM_MODEL=my-free-deepseek-v4-flash
LLM_MAX_TOKENS=2048

# ==== Telegram ====
# Kosongkan jika belum punya / hanya mau pakai --dry-run
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# parse_mode pesan Telegram: kosongkan = plain text (paling aman dengan emoji) | "HTML" | "MarkdownV2"
TELEGRAM_PARSE_MODE=

# ==== Slot Prime Time (label judul pesan & nama file outputs/) ====
PRIME_TIME_SIANG=SIANG
PRIME_TIME_SORE=SORE
PRIME_TIME_MALAM=MALAM